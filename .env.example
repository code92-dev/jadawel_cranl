# An example .env file for use with only the default `docker-compose.yml`.
# Developers: Use .env.dev.example when using the `docker-compose.dev.yml` override.
#
# Every backend environment variable is listed with its default in
# `docker-compose.yml` under the `x-backend-variables` anchor.
#
# The following 3 environment variables are mandatory and must be set by you to secure
# random values. Use a command like 'tr -dc 'a-z0-9' < /dev/urandom | head -c50' to
# generate a unique value for each one.

SECRET_KEY=
DATABASE_PASSWORD=
REDIS_PASSWORD=

# To increase the security of the SECRET_KEY, you should also set
# JADAWEL_JWT_SIGNING_KEY=

# The browser URL you will access Jadawel with. Used to connect to the api, generate emails, etc.
JADAWEL_PUBLIC_URL=http://localhost

# Uncomment and set/change these if you want to use an external postgres.
DATABASE_USER=jadawel
DATABASE_NAME=jadawel
# DATABASE_HOST=
# DATABASE_PORT=
# DATABASE_URL=
# DATABASE_OPTIONS=

# Uncomment and set these if you want to use an external redis.
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PROTOCOL=
# REDIS_URL=
# REDIS_USER=
# REDIS_SSL_CERT_REQS=
# REDIS_SSL_CA_CERTS=

# MCP protected-field token vault. Use a dedicated Redis in production. The
# fingerprint key map contains base64-encoded 32-byte keys and must stay private.
# JADAWEL_MCP_PROTECTION_REDIS_URL=
# JADAWEL_MCP_PROTECTION_FINGERPRINT_KEYS={"current":"<base64-32-byte-key>"}
# JADAWEL_MCP_PROTECTION_ACTIVE_KEY_ID=current
# JADAWEL_MCP_PROTECTION_ALLOW_SHARED_REDIS=false

# Uncomment and set these to enable Jadawel to send emails. Any non-empty value
# reads as true, so unset a flag rather than setting it to "false". Production
# uses Resend over SMTP — see docs/EMAIL_SETUP.md.
# EMAIL_SMTP=yes
# EMAIL_SMTP_HOST=smtp.resend.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USE_TLS=yes
# EMAIL_SMTP_USER=resend
# EMAIL_SMTP_PASSWORD=          # the re_... API key, never committed
# FROM_EMAIL=info@jadawl.site

# Uncomment and set these to use AWS S3 bucket to store user files.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=

# Misc settings - defaults are listed in docker-compose.yml
# JADAWEL_AMOUNT_OF_WORKERS=
# JADAWEL_ROW_PAGE_SIZE_LIMIT=
# BATCH_ROWS_SIZE_LIMIT=
# INITIAL_TABLE_DATA_LIMIT=
