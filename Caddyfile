{
	on_demand_tls {
        ask {$PRIVATE_BACKEND_URL:localhost:8000}/api/builder/domains/ask-public-domain-exists/
    }

    {$JADAWEL_CADDY_GLOBAL_CONF}
}

(jadawel_media_files) {
    handle_path /media/* {
        @downloads {
            query dl=*
        }
        header @downloads Content-Disposition "attachment; filename={query.dl}"
        header X-Content-Type-Options "nosniff"
        header Content-Security-Policy "sandbox; default-src 'none'; script-src 'none'; object-src 'none'; base-uri 'none'"

        # Allow to call head from public url to get size
        header {
            Access-Control-Allow-Origin {$JADAWEL_PUBLIC_URL:http://localhost}
            Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            Access-Control-Allow-Headers "*"
            Access-Control-Expose-Headers "Content-Length, Content-Type"
        }

        file_server {
            root {$MEDIA_ROOT:/jadawel/media/}
        }
    }
}

{$JADAWEL_CADDY_ADDRESSES} {
    tls {
        on_demand
    }

    # Baseline response headers. Set here rather than at the edge proxy so they
    # survive a change of reverse proxy, and so a local `docker compose` bring-up
    # behaves like production.
    #
    # No Content-Security-Policy is set globally on purpose: Nuxt serves inline
    # bootstrap scripts, so a useful policy needs nonces or hashes and would
    # silently break the app if guessed at. The media handler below keeps its own
    # much stricter sandbox policy for user-uploaded files, which is where an
    # injected script would actually be dangerous.
    #
    header {
        # Traefik already redirects http->https unconditionally, so pinning
        # browsers to https for a year adds no new failure mode. Note it is
        # sticky: a browser that has seen this will refuse plain http for the
        # full max-age even if the header is later removed.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        # same-origin-allow-popups rather than same-origin: OAuth/SSO flows open
        # providers in popups, and plain same-origin would cut their window.opener
        # relationship. The weaker variant still isolates the app from unrelated
        # cross-origin tabs (Spectre-class attacks on DOM/API responses).
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        # Advertises the framework and its version to anyone fingerprinting.
        -X-Powered-By
    }

    # RFC 9116 security policy discovery. Static text, so no origin risk; the
    # Expires field must be refreshed (this one is set to roll over in a year).
    #
    # Canonical is built from the request host rather than JADAWEL_PUBLIC_URL:
    # that variable may carry a trailing slash (production's does), which
    # printed `https://app.jadawl.site//.well-known/...`. https is hardcoded
    # because TLS terminates in front of this server, and RFC 9116 requires the
    # file to be fetched over https anyway.
    handle /\.well-known/security.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond <<EOF
Contact: mailto:gotoaziz100@gmail.com
Expires: 2027-09-30T00:00:00.000Z
Preferred-Languages: ar, en
Canonical: https://{http.request.host}/.well-known/security.txt
EOF
    }

    # Clickjacking protection for the signed-in application only.
    #
    # `/form/*` and `/public/*` are the shared-link routes customers embed in
    # their own sites, so they must stay framable by anyone. `/media/*` is left
    # out because the media handler below already sends a far stricter
    # `sandbox` policy, and a second CSP header would combine with it.
    #
    # `'self'` rather than `'none'`: clickjacking needs a third-party page to do
    # the framing, and the application builder previews pages in a same-origin
    # iframe, which `'none'` would break.
    @app_only {
        not path /form/* /public/* /media/* /api/webhooks/*
    }
    # `>` replaces the field instead of adding to it. Django sends its own
    # `X-Frame-Options: DENY` on API responses, and without this a request that
    # returns an upstream error through this route ends up with two conflicting
    # values in the same response.
    header @app_only {
        >Content-Security-Policy "frame-ancestors 'self'"
        >X-Frame-Options "SAMEORIGIN"
    }

    # A workflow's Response step answers on `/api/webhooks/*` with a body and
    # content type the workflow chose, which can echo the caller's own input.
    # Django marks that answer `sandbox` so a browser never runs it as this
    # origin. The replace above would drop that, so these routes get their own
    # policy carrying both.
    @workflow_responses {
        path /api/webhooks/*
    }
    header @workflow_responses {
        >Content-Security-Policy "sandbox; frame-ancestors 'self'"
        >X-Frame-Options "SAMEORIGIN"
    }

    @is_jadawel_tool {
        expression `
            "{$JADAWEL_PUBLIC_URL}".contains({http.request.host}) ||
            "{$JADAWEL_EXTRA_PUBLIC_URLS}".split(",")
                .filter(u, u != "" && u.contains({http.request.host}))
                .size() > 0
        `
    }

    @is_jadawel_media {
        path /media/*
        expression `
            "{$MEDIA_URL:}".startsWith("http://" + {http.request.host} + "/") ||
            "{$MEDIA_URL:}".startsWith("https://" + {http.request.host} + "/") ||
            "{$MEDIA_URL:}".startsWith("http://" + {http.request.host} + ":") ||
            "{$MEDIA_URL:}".startsWith("https://" + {http.request.host} + ":")
        `
    }

    # A source map is the complete original source of the application. The build
    # still emits them so they can be uploaded to an error tracker, and marking
    # them `hidden` removes the `sourceMappingURL` pointer from each chunk — but
    # the files themselves stay on disk and remain fetchable by anyone who
    # appends `.map` to a chunk URL. This is what actually stops them going out.
    #
    # Scoped to the build output rather than every `*.map`, so a user who
    # uploads a file named `something.map` can still download their own file.
    @build_sourcemaps path /_nuxt/*.map /static/*.map
    handle @build_sourcemaps {
        respond 404
    }

    # Build assets may be fetched from a second hostname (NUXT_APP_CDN_URL).
    # CranL's edge never caches a request that carries a cookie, and the app sets
    # one on its own host, so every one of the ~150 chunks of a page load went
    # through to this container and the burst came back as 429s and 504s. A host
    # the app never sets a cookie on is cached at the edge. Pages load these with
    # `crossorigin`, and fonts are always fetched in CORS mode, so that host has
    # to send CORS. `*` is safe: these are public build files, requested without
    # credentials, and one fixed value keeps a single cached copy for every
    # origin instead of a copy per `Origin`.
    @build_assets path /_nuxt/* /fonts/*
    header @build_assets Access-Control-Allow-Origin "*"

    # Served from disk rather than proxied to Node, so a cold cache costs a file
    # read instead of a Node request. Only for files that exist here: in the
    # all-in-one image the frontend's output sits in this container, while a
    # Caddy in its own container (docker-compose.yml) has no such directory and
    # keeps proxying. `builds/` is the deploy manifest the client polls for new
    # releases, so it keeps Nitro's short cache rather than `immutable`.
    @build_assets_on_disk {
        path /_nuxt/* /fonts/*
        not path /_nuxt/builds/*
        file {
            root {$JADAWEL_WEB_FRONTEND_PUBLIC_ROOT:/jadawel/web-frontend/.output/public}
        }
    }
    handle @build_assets_on_disk {
        # Same value Nitro sends: every `/_nuxt` file name carries a content hash.
        header /_nuxt/* Cache-Control "public, max-age=31536000, immutable"
        # Fonts are not hashed, so a week rather than forever.
        header /fonts/* Cache-Control "public, max-age=604800"
        # gzip only, as Nitro did: the edge caches one copy per encoding.
        encode gzip
        file_server {
            root {$JADAWEL_WEB_FRONTEND_PUBLIC_ROOT:/jadawel/web-frontend/.output/public}
        }
    }

    handle @is_jadawel_media {
        import jadawel_media_files
    }

    handle @is_jadawel_tool {
        @backend_routes path /api/* /ws/* /mcp/* /assistant/* {$JADAWEL_CADDY_BACKEND_EXTRA_ROUTES:}
        handle @backend_routes {
            reverse_proxy {$PRIVATE_BACKEND_URL:localhost:8000}
        }

        import jadawel_media_files

        handle_path /static/* {
            file_server {
                root {$STATIC_ROOT:/jadawel/static/}
            }
        }
    }

    reverse_proxy {$PRIVATE_WEB_FRONTEND_URL:localhost:3000}
}
