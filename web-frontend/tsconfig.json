{
  // Nuxt 4 emits one tsconfig per environment; reference them all so the editor and
  // `tsc -b` see the app, server, shared and node type sets.
  // See https://nuxt.com/docs/4.x/getting-started/upgrade
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" }
  ]
}
